# Deny access to uploads directory listing
Options -Indexes

# Allow only image files
<FilesMatch "\.(jpg|jpeg|png|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny access to all other file types
<FilesMatch "\.(?!jpg|jpeg|png|gif$)">
    Order Deny,Allow
    Deny from all
</FilesMatch>
